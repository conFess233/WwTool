  <sys:Double x:Key="GridLineOpacity">0.05</sys:Double>
  <sys:Double x:Key="GlowOpacity">0.14</sys:Double>
  <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>
  <BoxShadows x:Key="ShadowIsland">0 12 28 -10 #4C000000</BoxShadows>
  <BoxShadows x:Key="ShadowFab">0 12 26 -8 #53000000</BoxShadows>
  <BoxShadows x:Key="ShadowMenu">0 18 36 -16 #46000000</BoxShadows>
  <BoxShadows x:Key="ShadowDialog">0 24 50 -20 #46000000</BoxShadows>
  <BoxShadows x:Key="ShadowHover">0 14 22 -14 #40000000</BoxShadows>
  <BoxShadows x:Key="ShadowPill">0 8 22 -10 #39000000</BoxShadows>
  <BoxShadows x:Key="ShadowSoft">0 1 3 0 #17000000</BoxShadows>
  <CornerRadius x:Key="CornerRadiusSmall">7</CornerRadius>
  <CornerRadius x:Key="CornerRadiusControl">7</CornerRadius>
  <CornerRadius x:Key="CornerRadiusCard">12</CornerRadius>
  <CornerRadius x:Key="CornerRadiusInner">10</CornerRadius>
