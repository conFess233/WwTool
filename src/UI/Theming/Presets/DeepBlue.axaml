  <Color x:Key="AccentContainerHoverColor">#2A4170</Color>
  <Color x:Key="FocusRingColor">#3D6FD6</Color>
  <Color x:Key="HighlightColor">#1F2C4A</Color>
  <Color x:Key="HighlightStrongColor">#1E2A45</Color>
  <Color x:Key="GoldLightColor">#F5D27A</Color>
