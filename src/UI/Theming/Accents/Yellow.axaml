<!-- 强调色联动表：填充与填充上文字固定，文字与淡底按主题深浅取值（ThemeService 选择并派生描边等）。 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Color x:Key="AccentColor">#C9A227</Color>
  <Color x:Key="TextOnAccentColor">#2B2620</Color>
  <Color x:Key="AccentTextLightColor">#8A6D10</Color>
  <Color x:Key="AccentTextDarkColor">#E3C45E</Color>
  <Color x:Key="AccentContainerLightColor">#F5EDCF</Color>
  <Color x:Key="AccentContainerDarkColor">#33291A</Color>
</ResourceDictionary>
