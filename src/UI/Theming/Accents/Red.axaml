<!-- 强调色联动表：填充与填充上文字固定，文字与淡底按主题深浅取值（ThemeService 选择并派生描边等）。 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Color x:Key="AccentColor">#C24A3A</Color>
  <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
  <Color x:Key="AccentTextLightColor">#A33A2C</Color>
  <Color x:Key="AccentTextDarkColor">#F09A8C</Color>
  <Color x:Key="AccentContainerLightColor">#F8E1DD</Color>
  <Color x:Key="AccentContainerDarkColor">#3A1F1B</Color>
</ResourceDictionary>
