<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Color x:Key="AccentColor">#80689B</Color>
  <Color x:Key="AccentHoverColor">#846C9C</Color>
  <Color x:Key="AccentPressedColor">#69547F</Color>
  <Color x:Key="AccentContainerColor">#3380689B</Color>
  <Color x:Key="AccentContainerHoverColor">#4A80689B</Color>
  <Color x:Key="FocusRingColor">#937BAB</Color>
  <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
  <Color x:Key="ChartPrimaryColor">#80689B</Color>
</ResourceDictionary>
