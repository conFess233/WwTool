<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fb="using:WwTool.UI.Feedback"
             x:Class="WwTool.UI.Feedback.ConfirmDialogView"
             x:DataType="fb:ConfirmDialogViewModel"
             MaxWidth="424">
  <StackPanel Spacing="16">
    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
               Foreground="{DynamicResource TextPrimaryBrush}" />
    <TextBlock Text="{Binding Message}" FontSize="14" TextWrapping="Wrap" LineHeight="22"
               Foreground="{DynamicResource TextSecondaryBrush}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="CancelButton" Classes="dialog-secondary" Content="{Binding CancelText}" IsVisible="{Binding HasCancel}"
              Command="{Binding DismissCommand}" AutomationProperties.AutomationId="dialog-cancel" />
      <Button x:Name="ConfirmButton" Classes="dialog-primary" Classes.danger="{Binding IsDanger}"
              Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
              AutomationProperties.AutomationId="dialog-confirm" />
    </StackPanel>
  </StackPanel>
</UserControl>
