<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fb="using:WwTool.UI.Feedback"
             x:Class="WwTool.UI.Feedback.DialogOverlay"
             x:DataType="fb:DialogService"
             IsVisible="{Binding IsOpen}">
  <!-- 窗口内对话框：遮罩淡入，卡片小幅缩放上移进入；Tab 焦点在卡片内循环。 -->
  <UserControl.Styles>
    <Style Selector="Border#Card">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateY(8px) scale(0.97)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#Card.shown">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.dialog-primary, Button.dialog-secondary">
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.dialog-primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.dialog-primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>
    <Style Selector="Button.dialog-primary.danger">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.dialog-primary.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.dialog-secondary">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <!-- 用圆角焦点环替代 Fluent 的方形焦点装饰 -->
    <Style Selector="Button">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Border x:Name="Scrim" Background="#73000000" PointerPressed="OnScrimPressed" />
    <Border x:Name="Card" MaxWidth="480" MinWidth="360" Margin="24" Padding="28,24"
            HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="20"
            Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            BoxShadow="0 24 48 -12 #66000000"
            KeyboardNavigation.TabNavigation="Cycle"
            AutomationProperties.AutomationId="dialog-card">
      <ContentControl Content="{Binding Current}" />
    </Border>
  </Grid>
</UserControl>
