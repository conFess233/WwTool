<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:home="using:WwTool.UI.Pages.Home"
             xmlns:pulls="using:WwTool.UI.Pages.Pulls"
             xmlns:shell="using:WwTool.UI.Shell"
             xmlns:c="using:WwTool.UI.Controls"
             xmlns:loc="using:WwTool.UI.Localization"
             x:Class="WwTool.UI.Pages.Home.HomeView"
             x:DataType="home:HomeViewModel">
  <!--
    首页（定稿 FinalHome，底纹版）：左栏自适应，上「账号总览」、下「便捷操作」，高度比 1.35 : 1；
    右栏固定 430 宽为「游戏公告」，底部留 76 给悬浮按钮。窗口过矮时整页滚动。
  -->
  <UserControl.Styles>
    <!-- 首页卡片：左上、右下金色角标 -->
    <Style Selector="c|CornerMarks">
      <Setter Property="Brush" Value="{DynamicResource AccentLineBrush}" />
    </Style>

    <!-- 统计行：上下分隔线，五列等宽，列间竖线 -->
    <Style Selector="Border.stat">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="Padding" Value="18,0,4,0" />
    </Style>
    <Style Selector="Border.stat.first">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,0,4,0" />
    </Style>

    <!-- 资源小卡 -->
    <Style Selector="Border.res">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,14,14,12" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="TextBlock.kv-key">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="c|RollingText.kv-value">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FlashBrush" Value="{DynamicResource GoldLightBrush}" />
    </Style>
    <Style Selector="c|RollingText.flash">
      <Setter Property="FlashOnChange" Value="True" />
      <Setter Property="FlashBrush" Value="{DynamicResource GoldLightBrush}" />
    </Style>
    <Style Selector="Border.cell">
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource SegmentTrackBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.42" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.cell.on">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- 「已满」：闪烁（减少动画时常亮） -->
    <Style Selector="Border.full-tag">
      <Setter Property="Background" Value="{DynamicResource AccentContainerBrush}" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.full-tag > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Window:not(.reduced) Border.full-tag">
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="Infinite" Easing="0.45,0,0.55,1">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- 便捷操作按钮：左上 38 图标底，左下 14 SemiBold 文字；悬停上浮 4、阴影、描边转 Accent Line；按下 96% -->
    <Style Selector="Button.quick">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Body" CornerRadius="10" BorderThickness="1" ClipToBounds="True"
                  Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource DividerBrush}"
                  RenderTransform="translateY(0px) scale(1)">
            <Border.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="0.2,0.8,0.2,1" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                <BrushTransition Property="Background" Duration="0:0:0.24" />
              </Transitions>
            </Border.Transitions>
            <Panel>
              <!-- 启动中的微光 -->
              <Border Name="PART_Shimmer" Width="90" HorizontalAlignment="Left" IsVisible="False" Opacity="0.35">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#99FFFFFF" Offset="0.5" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.quick:pointerover /template/ Border#PART_Body">
      <Setter Property="RenderTransform" Value="translateY(-4px) scale(1)" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    </Style>
    <Style Selector="Button.quick:pressed /template/ Border#PART_Body">
      <Setter Property="RenderTransform" Value="translateY(-2px) scale(0.96)" />
    </Style>
    <Style Selector="Window.reduced Button.quick:pointerover /template/ Border#PART_Body">
      <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
    </Style>
    <Style Selector="Button.quick:focus-visible /template/ Border#PART_Body">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
    </Style>
    <Style Selector="Button.quick Border.disc">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Background" Value="{DynamicResource AccentContainerBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.24" />
        </Transitions>
      </Setter>
    </Style>
    <!-- UID 后的复制按钮：22 方形透明底，悬停浅底；复制成功后图标换绿色对勾 2 秒 -->
    <!-- 账号卡右上角的刷新按钮：40 圆形，Surface 底与描边，悬停强调描边；同步中图标持续旋转、按钮不可点 -->
    <Style Selector="Button.refresh-data">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="0.2,0.8,0.2,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.refresh-data:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.refresh-data:pressed">
      <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>
    <Style Selector="Button.refresh-data:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.refresh-data c|StrokeIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    </Style>
    <Style Selector="Button.refresh-data.spinning c|StrokeIcon">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Button.copy-uid">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.copy-uid:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.copy-uid:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentContainerBrush}" />
    </Style>
    <Style Selector="Button.copy-uid c|StrokeIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="StrokeThickness" Value="1.8" />
    </Style>
    <Style Selector="Button.copy-uid c|StrokeIcon.check">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Button.copy-uid.copied c|StrokeIcon.check">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.copy-uid.copied c|StrokeIcon.copy">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- 右下角水印：对应功能的放大图标，一部分伸出按钮边缘被裁掉 -->
    <Style Selector="Button.quick c|StrokeIcon.watermark">
      <Setter Property="Width" Value="76" />
      <Setter Property="Height" Value="76" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="0,0,-22,-24" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Opacity" Value="0.09" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.quick.success c|StrokeIcon.watermark">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Button.quick TextBlock.title">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 主按钮「启动游戏」：Accent 底白字，图标底白色 20% -->
    <Style Selector="Button.quick.primary">
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>
    <Style Selector="Button.quick.primary /template/ Border#PART_Body">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
    </Style>
    <Style Selector="Button.quick.primary:pointerover /template/ Border#PART_Body">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.quick.primary c|StrokeIcon.watermark">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="0.16" />
    </Style>
    <Style Selector="Button.quick.primary Border.disc">
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>
    <!-- 正在启动：按钮加深、微光扫过 -->
    <Style Selector="Button.quick.busy.primary /template/ Border#PART_Body">
      <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    </Style>
    <Style Selector="Button.quick.busy.primary /template/ Border#PART_Shimmer">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Window:not(.reduced) Button.quick.busy.primary /template/ Border#PART_Shimmer">
      <Style.Animations>
        <Animation Duration="0:0:1.6" IterationCount="Infinite" Easing="0.45,0,0.55,1">
          <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="-100" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="320" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- 已复制：底色转绿，图标底为绿色 -->
    <Style Selector="Button.quick.success">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Button.quick.success /template/ Border#PART_Body">
      <Setter Property="Background" Value="{DynamicResource SuccessContainerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessLineBrush}" />
    </Style>
    <Style Selector="Button.quick.success Border.disc">
      <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <!-- 游戏运行中：绿点闪烁 -->
    <Style Selector="Ellipse.live">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="#6FD08C" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Window:not(.reduced) Ellipse.live">
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="Infinite" Easing="0.45,0,0.55,1">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- 公告行：上下内边距 11，行间分隔线 -->
    <Style Selector="Button.ann-row">
      <Setter Property="Padding" Value="0,11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ItemsControl.ann-list > ContentPresenter:nth-child(1) Button.ann-row /template/ Border">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.ann-row:pointerover TextBlock.ann-title">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer x:Name="Scroller" Classes="page-scroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid x:Name="Root" ColumnDefinitions="*,430" RowDefinitions="Auto,*" ColumnSpacing="18" Margin="0,0,0,26" MinHeight="620">

      <!-- 网络异常（定稿「空状态与异常」）：顶部红色横条，下方照常显示缓存数据 -->
      <Border Grid.ColumnSpan="2" Margin="0,0,0,14" Padding="12,10" CornerRadius="8" Background="{DynamicResource DangerContainerBrush}"
              IsVisible="{Binding IsOffline}" AutomationProperties.AutomationId="home-offline">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <c:StrokeIcon Width="18" Height="18" StrokeThickness="1.8" Data="{StaticResource Icon.Warning}" Foreground="{DynamicResource DangerBrush}" />
          <TextBlock Grid.Column="1" FontSize="13" Text="{Binding OfflineText}" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" />
          <Button Grid.Column="2" Classes="link" FontSize="13" Foreground="{DynamicResource DangerBrush}" Command="{Binding RetrySyncCommand}"
                  AutomationProperties.AutomationId="home-offline-retry">
            <TextBlock Text="{loc:Tr Common_Retry}" TextDecorations="Underline" FontWeight="Bold" />
          </Button>
        </Grid>
      </Border>

      <!-- ── 左栏 ── -->
      <Grid Grid.Row="1" RowDefinitions="1.35*,*" RowSpacing="18">

        <!-- 账号总览 -->
        <Border Classes="card" Padding="22,20,22,22" ClipToBounds="True" AutomationProperties.AutomationId="home-profile">
          <Panel>
            <!-- 右上点阵与 Logo 水印 -->
            <c:DotField Width="420" Height="200" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-60,-52,0"
                        Brush="{DynamicResource AccentBrush}" Opacity="0.28" />
            <Image Source="avares://WwTool/Assets/WwTool.ico" Width="120" Height="120" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,2,4,0" Opacity="0.08" IsHitTestVisible="False" />

            <!-- 首次启动：欢迎使用 WwTool（84 软件 Logo） -->
            <c:EmptyState IsVisible="{Binding !Accounts.HasAccount}" Title="{loc:Tr Home_WelcomeTitle}" Description="{loc:Tr Home_WelcomeHint}"
                          AutomationProperties.AutomationId="home-no-account">
              <c:EmptyState.Graphic>
                <Border Width="84" Height="84" CornerRadius="42" ClipToBounds="True" Background="#EFE7D8">
                  <Image Source="avares://WwTool/Assets/WwTool.ico" />
                </Border>
              </c:EmptyState.Graphic>
              <StackPanel Classes="empty-actions">
                <Button Classes="btn primary" Content="{loc:Tr Dialog_AddAccount}" Command="{Binding AddAccountCommand}"
                        AutomationProperties.AutomationId="home-welcome-add" />
                <Button Classes="btn" Content="{loc:Tr Home_OnlyPulls}" Command="{Binding OnlyPullsCommand}"
                        AutomationProperties.AutomationId="home-welcome-pulls" />
              </StackPanel>
            </c:EmptyState>

            <!-- 首次同步中：110 加载形象 + 刻度进度条 -->
            <c:EmptyState IsVisible="{Binding IsFirstSync}" Title="{loc:Tr Home_FirstSyncTitle}" Background="{DynamicResource SurfaceBrush}"
                          AutomationProperties.AutomationId="home-first-sync">
              <c:EmptyState.Graphic>
                <c:PixelGif Width="110" Height="110" />
              </c:EmptyState.Graphic>
              <StackPanel Spacing="12" Margin="0,-4,0,0">
                <c:SegmentedBar Width="260" Height="8" Maximum="1" Value="{Binding FirstSyncProgress}" Shimmer="True" />
                <TextBlock FontSize="13" HorizontalAlignment="Center" Text="{loc:Tr Home_FirstSyncHint}" Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
            </c:EmptyState>

            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18" IsVisible="{Binding ShowProfile}">
              <!-- 身份行；右侧为快速刷新账号数据的按钮 -->
              <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Border Width="64" Height="64" CornerRadius="32" ClipToBounds="True" Background="{DynamicResource AccentContainerBrush}">
                  <Panel>
                    <TextBlock FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="{Binding Accounts.DisplayName, Converter={x:Static pulls:InitialConverter.Instance}}"
                               IsVisible="{Binding #Avatar.Source, Converter={x:Static ObjectConverters.IsNull}}" />
                    <c:CatalogImage x:Name="Avatar" Path="{Binding Accounts.Current.IconPath}" DecodeWidth="128" Stretch="UniformToFill" />
                  </Panel>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Accounts.DisplayName}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="{Binding Accounts.Current.Level, StringFormat='LV.{0}'}" IsVisible="{Binding Accounts.HasLevel}"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,3,0,0" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="aux muted" Text="{Binding UidLine}" VerticalAlignment="Center" />
                    <Button Classes="copy-uid" Classes.copied="{Binding IsUidCopied}" AutomationProperties.AutomationId="home-copy-uid"
                            Command="{Binding CopyUidCommand}" IsVisible="{Binding Accounts.HasAccount}"
                            ToolTip.Tip="{Binding CopyUidTip}">
                      <Panel>
                        <c:StrokeIcon Classes="copy" Data="{StaticResource Icon.Copy}" />
                        <c:StrokeIcon Classes="check" Data="{StaticResource Icon.Check}" />
                      </Panel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
                <Button Grid.Column="1" Classes="refresh-data" Classes.spinning="{Binding IsSyncing}" VerticalAlignment="Center"
                        Command="{Binding RefreshDataCommand}" ToolTip.Tip="{loc:Tr Fab_RefreshData}"
                        AutomationProperties.Name="{loc:Tr Fab_RefreshData}" AutomationProperties.AutomationId="home-refresh-data">
                  <c:StrokeIcon Data="{StaticResource Icon.Sync}" />
                </Button>
              </Grid>

              <!-- 统计行 -->
              <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1" Padding="0,14">
                <UniformGrid Columns="5">
                  <Border Classes="stat first">
                    <StackPanel Spacing="4"><TextBlock Classes="caption" Text="{loc:Tr Index_ActiveDays}" /><c:RollingText Classes="flash" FontSize="22" FontWeight="Bold" Text="{Binding ActiveDays}" /></StackPanel>
                  </Border>
                  <Border Classes="stat">
                    <StackPanel Spacing="4"><TextBlock Classes="caption" Text="{loc:Tr Index_CreateDate}" /><c:RollingText Classes="flash" FontSize="22" FontWeight="Bold" Text="{Binding CreateDate}" /></StackPanel>
                  </Border>
                  <Border Classes="stat">
                    <StackPanel Spacing="4"><TextBlock Classes="caption" Text="{loc:Tr Index_SolaLevel}" /><c:RollingText Classes="flash" FontSize="22" FontWeight="Bold" Text="{Binding WorldLevel}" /></StackPanel>
                  </Border>
                  <Border Classes="stat">
                    <StackPanel Spacing="4"><TextBlock Classes="caption" Text="{loc:Tr Index_Server}" /><TextBlock FontSize="22" FontWeight="Bold" Text="{Binding Server}" TextTrimming="CharacterEllipsis" /></StackPanel>
                  </Border>
                  <Border Classes="stat">
                    <StackPanel Spacing="4"><TextBlock Classes="caption" Text="{loc:Tr Index_OwnedRoles}" /><c:RollingText Classes="flash" FontSize="22" FontWeight="Bold" Text="{Binding RoleCount}" /></StackPanel>
                  </Border>
                </UniformGrid>
              </Border>

              <!-- 资源卡 -->
              <ItemsControl Grid.Row="2" ItemsSource="{Binding Resources}" AutomationProperties.AutomationId="home-resources">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="12" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="home:ResourceCard">
                    <Panel>
                      <c:OrbitGlow IsHalo="True" IsActive="{Binding IsFull}" Radius="10"
                                   Color="{DynamicResource AccentColor}" LightColor="{DynamicResource GoldLightColor}" />
                      <Border Classes="res">
                        <Panel>
                          <c:HatchStrip Height="46" VerticalAlignment="Top" Margin="-14,-14,-14,0"
                                        Brush="{DynamicResource AccentBrush}" Opacity="0.06" />
                          <Grid RowDefinitions="Auto,Auto,Auto,*">
                            <DockPanel>
                              <Image DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,8,0" Source="{Binding Icon, Converter={x:Static shell:AssetImageConverter.Instance}}" />
                              <Border DockPanel.Dock="Right" Classes="full-tag" Margin="6,0,0,0" IsVisible="{Binding IsFull}">
                                <TextBlock Text="{loc:Tr Home_Full}" />
                              </Border>
                              <TextBlock Classes="label" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                              <c:RollingText Classes="flash" Text="{Binding Value}" FontSize="34" FontWeight="Bold" LetterSpacing="-0.5" />
                              <TextBlock Classes="unit" Margin="4,0,0,4" VerticalAlignment="Bottom" Text="{Binding Suffix}"
                                         IsVisible="{Binding Suffix, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                            <c:SegmentedBar Grid.Row="2" Classes="thin" Margin="0,10,0,0" IsVisible="{Binding HasBar}"
                                            Value="{Binding Current}" Maximum="{Binding Maximum}" />
                            <ItemsControl Grid.Row="2" Margin="0,10,0,0" ItemsSource="{Binding Cells}" IsVisible="{Binding IsWeekly}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="6" /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:Boolean">
                                  <Border Classes="cell" Classes.on="{Binding}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Row="3" ItemsSource="{Binding Rows}" VerticalAlignment="Bottom" Margin="0,12,0,0">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="7" /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="home:KeyValueRow">
                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Classes="kv-key" Text="{Binding Key}" TextTrimming="CharacterEllipsis" />
                                    <c:RollingText Grid.Column="1" Classes="kv-value" HorizontalAlignment="Right" Text="{Binding Value}"
                                                   FlashOnChange="{Binding !IsLive}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Grid>
                        </Panel>
                      </Border>
                      <c:OrbitGlow IsActive="{Binding IsFull}" Radius="10"
                                   Color="{DynamicResource AccentColor}" LightColor="{DynamicResource GoldLightColor}" />
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
            <c:CornerMarks Margin="-22,-20,-22,-22" />
          </Panel>
        </Border>

        <!-- 便捷操作 -->
        <Border Grid.Row="1" Classes="card" Padding="22,18,22,20" AutomationProperties.AutomationId="home-quick">
          <Panel>
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Classes="card-title" Text="{loc:Tr Home_QuickActions}" />
              <ItemsControl Grid.Row="1" ItemsSource="{Binding QuickActions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="4" Rows="2" ColumnSpacing="12" RowSpacing="12" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="home:QuickAction">
                    <Button Classes="quick" Classes.primary="{Binding IsPrimary}" Classes.busy="{Binding IsBusy}" Classes.success="{Binding IsSuccess}"
                            Command="{Binding Command}" AutomationProperties.AutomationId="{Binding AutomationId}"
                            AutomationProperties.Name="{Binding Title}">
                      <Grid RowDefinitions="*,Auto" RowSpacing="8">
                        <c:StrokeIcon Grid.RowSpan="2" Classes="watermark" Data="{Binding Icon, Converter={x:Static home:IconKeyConverter.Instance}}" />
                        <Border Classes="disc">
                          <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <c:StrokeIcon Width="20" Height="20" Data="{Binding Icon, Converter={x:Static home:IconKeyConverter.Instance}}">
                              <c:StrokeIcon.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                  <Binding Path="!IsBusy" />
                                  <Binding Path="!IsSuccess" />
                                </MultiBinding>
                              </c:StrokeIcon.IsVisible>
                            </c:StrokeIcon>
                            <c:StrokeIcon Width="20" Height="20" Data="{StaticResource Icon.Check}" IsVisible="{Binding IsSuccess}" />
                            <c:PixelGif Width="30" Height="30" Margin="-5" IsVisible="{Binding IsBusy}" />
                          </Panel>
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="7">
                          <Ellipse Classes="live" IsVisible="{Binding IsRunning}" />
                          <TextBlock Classes="title" Text="{Binding Title}" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
            <c:CornerMarks Margin="-22,-18,-22,-20" />
          </Panel>
        </Border>
      </Grid>

      <!-- ── 右栏：游戏公告 ── -->
      <Border Grid.Row="1" Grid.Column="1" Classes="card" Padding="20,18,20,16" Margin="0,0,0,76" AutomationProperties.AutomationId="home-announcements">
        <Panel>
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
            <!-- 标题 + 国服 / 国际服滑块 -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="card-title" Text="{loc:Tr Home_Announcements}" VerticalAlignment="Center" />
              <Border Grid.Column="1" Classes="region" AutomationProperties.AutomationId="home-ann-region">
                <Panel>
                  <Border Classes="region-thumb" Classes.right="{Binding IsGlobalRegion}" />
                  <UniformGrid Columns="2">
                    <RadioButton Classes="region-opt" Content="{loc:Tr Home_RegionCN}"
                                 IsChecked="{Binding IsChinaRegion}" AutomationProperties.AutomationId="home-ann-region-cn" />
                    <RadioButton Classes="region-opt" Content="{loc:Tr Home_RegionGlobal}"
                                 IsChecked="{Binding IsGlobalRegion}" AutomationProperties.AutomationId="home-ann-region-global" />
                  </UniformGrid>
                </Panel>
              </Border>
            </Grid>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Filters}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="home:AnnouncementFilter">
                  <RadioButton Classes="ann-chip" Content="{Binding Title}" IsChecked="{Binding IsSelected}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <home:BannerCarousel Grid.Row="2" Banners="{Binding Banners}" IsVisible="{Binding HasBanners}"
                                 Command="{Binding OpenBannerCommand}" AutomationProperties.AutomationId="home-ann-banner" />

            <ItemsControl Grid.Row="3" Classes="ann-list" ItemsSource="{Binding AnnouncementRows}" ClipToBounds="True">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="home:AnnouncementRow">
                  <Button Classes="ann-row" Command="{Binding $parent[ItemsControl].((home:HomeViewModel)DataContext).OpenAnnouncementCommand}"
                          CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <Border Classes="ntag" Classes.version="{Binding IsNews}" Classes.notice="{Binding IsNotice}">
                        <TextBlock Text="{Binding KindText}" />
                      </Border>
                      <TextBlock Grid.Column="1" Classes="aux ann-title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="caption" Text="{Binding DateText}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 暂无公告 / 加载中 / 获取失败 -->
            <StackPanel Grid.Row="2" Grid.RowSpan="2" IsVisible="{Binding ShowAnnouncementsEmpty}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="8" AutomationProperties.AutomationId="home-ann-empty">
              <c:PixelGif Width="56" Height="56" HorizontalAlignment="Center" />
              <TextBlock Classes="card-title" Text="{loc:Tr Home_AnnEmptyTitle}" HorizontalAlignment="Center" />
              <TextBlock Classes="caption" Text="{loc:Tr Home_AnnEmptyHint}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.RowSpan="2" IsVisible="{Binding ShowAnnouncementsLoading}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="8" AutomationProperties.AutomationId="home-ann-loading">
              <c:PixelGif Width="56" Height="56" HorizontalAlignment="Center" />
              <TextBlock Classes="caption" Text="{loc:Tr Home_AnnLoading}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.RowSpan="2" IsVisible="{Binding ShowAnnouncementsFailed}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="8" AutomationProperties.AutomationId="home-ann-failed">
              <c:PixelGif Width="56" Height="56" HorizontalAlignment="Center" />
              <TextBlock Classes="card-title" Text="{loc:Tr Home_AnnFailedTitle}" HorizontalAlignment="Center" />
              <TextBlock Classes="caption" Text="{loc:Tr Home_AnnFailedHint}" HorizontalAlignment="Center" />
              <Button Classes="btn" HorizontalAlignment="Center" Margin="0,6,0,0" Content="{loc:Tr Home_AnnRetry}"
                      Command="{Binding RetryAnnouncementsCommand}" AutomationProperties.AutomationId="home-ann-retry" />
            </StackPanel>

            <!-- 活动页（游戏内公告、卡池时间线、版本日历）与官网新闻页 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
              <Button Classes="link" Content="{loc:Tr Home_AnnOpenEvents}" Command="{Binding OpenEventsCommand}"
                      AutomationProperties.AutomationId="home-ann-events" />
              <Button Classes="link" Content="{loc:Tr Home_AnnViewAll}"
                      Command="{Binding OpenAllAnnouncementsCommand}" AutomationProperties.AutomationId="home-ann-all" />
            </StackPanel>
          </Grid>
          <c:CornerMarks Margin="-20,-18,-20,-16" />
        </Panel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
