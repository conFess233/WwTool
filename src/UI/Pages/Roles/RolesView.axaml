<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:roles="using:WwTool.UI.Pages.Roles"
             xmlns:domain="using:WwTool.Core.Models.Domain"
             xmlns:c="using:WwTool.UI.Controls"
             xmlns:loc="using:WwTool.UI.Localization"
             x:Class="WwTool.UI.Pages.Roles.RolesView"
             x:DataType="roles:RolesViewModel">
  <!--
    角色（定稿 FinalRoles）：顶部栏（已有角色 / 已装备武器、排序方式、同步时间），按星级分组的 6 列卡片。
    悬停：上浮 4、悬停阴影、随指针三维倾斜（最大 14°）并扫过白色光泽。
    点击角色：头像从格子飞到详情位置并变圆，详情浮层从右 16 滑入（520ms）；点空白处或 Esc 关闭。
  -->
  <UserControl.Styles>
    <!-- 角色卡：高 72、圆角 12；选中为 Accent Text 描边 + Highlight 底 + 3 宽 Accent Soft 光圈 -->
    <Style Selector="Border.tile">
      <Setter Property="Height" Value="72" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.tile:pointerover">
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowHover}" />
    </Style>
    <Style Selector="Border.tile.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource HighlightStrongBrush}" />
    </Style>
    <!-- 角色卡外层按钮：只负责点击与键盘，外观全由卡片自绘 -->
    <Style Selector="Button.tile-button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.tile-button:focus-visible Border.tile">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
    </Style>
    <Style Selector="Border.tile-ring">
      <Setter Property="Margin" Value="-3" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentContainerBrush}" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.avatar">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="52" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.stars">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LetterSpacing" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource FourStarBrush}" />
    </Style>
    <Style Selector="TextBlock.stars.five">
      <Setter Property="Foreground" Value="#C98A1B" />
    </Style>
    <!-- 共鸣链徽标：零至二链为灰，三至五链浅强调，六链强调实底 -->
    <Style Selector="Border.seq">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    </Style>
    <Style Selector="Border.seq > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
    </Style>
    <Style Selector="Border.seq.mid">
      <Setter Property="Background" Value="{DynamicResource AccentContainerBrush}" />
    </Style>
    <Style Selector="Border.seq.mid > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Border.seq.full">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.seq.full > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>
    <Style Selector="Border.weapon-tip">
      <Setter Property="Padding" Value="14,10" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <ScrollViewer x:Name="Scroller" Classes="page-scroll" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,0,96" Spacing="12">
        <!-- 顶部栏：页签、排序、同步时间 -->
        <Grid Height="40" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
          <ItemsControl ItemsSource="{Binding Tabs}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="roles:ChipOption">
                <ToggleButton Classes="chip" IsChecked="{Binding IsSelected, Mode=OneWay}"
                              Command="{Binding $parent[UserControl].((roles:RolesViewModel)DataContext).SelectTabCommand}" CommandParameter="{Binding}"
                              AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Title}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Classes="count" Text="{Binding Count}" VerticalAlignment="Center" />
                  </StackPanel>
                </ToggleButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="18,0,0,0" VerticalAlignment="Center">
            <TextBlock Classes="caption" Text="{loc:Tr Guide_Sort}" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding Sorts}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="roles:ChipOption">
                  <ToggleButton Classes="chip" Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=OneWay}" IsEnabled="{Binding IsEnabled}"
                                ToolTip.Tip="{Binding Hint}" ToolTip.ShowOnDisabled="True"
                                Command="{Binding $parent[UserControl].((roles:RolesViewModel)DataContext).SelectSortCommand}" CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="{Binding AutomationId}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
            <c:PixelGif Width="24" Height="24" IsVisible="{Binding IsSyncing}" />
            <TextBlock Classes="caption" Text="{Binding SyncInfo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="roles-sync-info" />
          </StackPanel>
        </Grid>

        <Border Classes="card" Padding="28,24" IsVisible="{Binding IsEmpty}" AutomationProperties.AutomationId="roles-empty">
          <TextBlock Classes="caption" Text="{Binding EmptyText}" TextWrapping="Wrap" />
        </Border>

        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="roles:TileGroup">
              <StackPanel Spacing="12">
                <!-- 组标题：「五星」15 Bold + 人数 13 Label + 延伸到右侧的分隔线 -->
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                  <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="label" Text="{Binding CountText}" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Tiles}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6" ColumnSpacing="12" RowSpacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

  </Panel>

  <UserControl.DataTemplates>
    <!-- 角色格：头像、名称、共鸣链、星级；悬停倾斜并扫光，点击打开角色详情弹窗 -->
    <DataTemplate DataType="roles:RoleTile">
      <c:TiltHost>
        <Button Classes="tile-button" Command="{Binding $parent[roles:RolesView].((roles:RolesViewModel)DataContext).OpenDetailCommand}" CommandParameter="{Binding}"
                AutomationProperties.AutomationId="{Binding AutomationId}"
                AutomationProperties.Name="{Binding Name}">
        <Panel>
          <Border Classes="tile-ring" IsVisible="{Binding IsSelected}" />
          <Border Classes="tile" Classes.selected="{Binding IsSelected}">
            <Panel>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="12,0">
                <Border Name="Avatar" Classes="avatar" VerticalAlignment="Center">
                  <c:CatalogImage Path="{Binding IconPath}" DecodeWidth="104" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="seq" Classes.mid="{Binding IsMidSequence}" Classes.full="{Binding IsFullSequence}">
                      <TextBlock Text="{Binding SequenceText}" />
                    </Border>
                  </Grid>
                  <TextBlock Classes="stars" Classes.five="{Binding IsFiveStar}" Text="{Binding StarsText}" />
                </StackPanel>
              </Grid>
              <c:GlossSweep />
            </Panel>
          </Border>
        </Panel>
        </Button>
      </c:TiltHost>
    </DataTemplate>

    <!-- 武器格：图标、名称、星级、装备者；悬停提示获取时间 -->
    <DataTemplate DataType="roles:WeaponTile">
      <c:TiltHost ToolTip.Tip="{Binding Hover}" ToolTip.ShowDelay="250">
        <Border Classes="tile" Cursor="Arrow" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Name}">
          <Panel>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="12,0">
              <Border Classes="avatar" VerticalAlignment="Center">
                <c:CatalogImage Path="{Binding IconPath}" DecodeWidth="104" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="stars" Classes.five="{Binding IsFiveStar}" Text="{Binding StarsText}" />
                <TextBlock Classes="caption" Text="{Binding OwnerText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              </StackPanel>
            </Grid>
            <c:GlossSweep />
          </Panel>
        </Border>
      </c:TiltHost>
    </DataTemplate>

    <DataTemplate DataType="roles:WeaponHover">
      <Border Classes="weapon-tip">
        <TextBlock Classes="caption" Text="{Binding Text}" />
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>
</UserControl>
