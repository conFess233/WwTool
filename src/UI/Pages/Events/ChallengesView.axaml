<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:events="using:WwTool.UI.Pages.Events"
             xmlns:c="using:WwTool.UI.Controls"
             xmlns:loc="using:WwTool.UI.Localization"
             x:Class="WwTool.UI.Pages.Events.ChallengesView"
             x:DataType="events:ChallengesViewModel">
  <!--
    活动页「挑战」栏（占满主体宽度）：顶部为玩法胶囊（深塔 / 海墟 / 矩阵）、期数切换与起止时间、数据来源；
    下面按玩法显示：深塔每个区域一张卡、4 层并排；海墟先列信物，再按区域分组、每关一张卡；矩阵两个模式并排，最后是加成角色。
    敌人为圆形头像格，右下角圆点为属性色，悬停显示等级、生命与各属性抗性。
  -->
  <UserControl.Styles>
    <!-- 头像：圆形凹槽底，图片加载前也有占位 -->
    <Style Selector="Border.avatar">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.avatar.gold">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.avatar.purple">
      <Setter Property="BorderBrush" Value="{DynamicResource FourStarBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- 属性圆点：描一圈卡片底色，压在头像右下角 -->
    <Style Selector="Ellipse.element">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stroke" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style Selector="TextBlock.sub">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    </Style>
    <Style Selector="Border.tag > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.ntag.ended">
      <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>
    <Style Selector="Border.ntag.ended > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Border.ntag.upcoming">
      <Setter Property="Background" Value="{DynamicResource InfoContainerBrush}" />
    </Style>
    <Style Selector="Border.ntag.upcoming > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
    </Style>
    <Style Selector="c|NoticeContent.desc">
      <Setter Property="TextSize" Value="12.5" />
      <Setter Property="LineSpacing" Value="1.5" />
      <Setter Property="Spacing" Value="2" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <!-- 敌人头像格 -->
    <DataTemplate x:DataType="events:MonsterItem">
      <StackPanel Width="78" Spacing="4" ToolTip.Tip="{Binding Tip}" Background="Transparent">
        <Panel Width="52" Height="52" HorizontalAlignment="Center">
          <Border Classes="avatar">
            <Image Source="{Binding Image}" Stretch="UniformToFill" />
          </Border>
          <Ellipse Classes="element" Fill="{Binding ElementBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Panel>
        <TextBlock Text="{Binding Name}" FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Highlight}" IsVisible="{Binding HasHighlight}" FontSize="10.5" FontWeight="SemiBold"
                   Foreground="{Binding ElementBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,*" RowSpacing="14">
      <!-- ── 玩法、期数与来源（固定在顶部，不随内容滚动） ── -->
      <Border Classes="card" Padding="20,14" Margin="0,0,4,0" AutomationProperties.AutomationId="challenge-header">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <RadioButton Classes="ann-chip" GroupName="challenge-kind" Content="{loc:Tr Challenge_Tower}" IsChecked="{Binding IsTower}"
                         AutomationProperties.AutomationId="challenge-tower" />
            <RadioButton Classes="ann-chip" GroupName="challenge-kind" Content="{loc:Tr Challenge_Wastes}" IsChecked="{Binding IsWastes}"
                         AutomationProperties.AutomationId="challenge-wastes" />
            <RadioButton Classes="ann-chip" GroupName="challenge-kind" Content="{loc:Tr Challenge_Matrix}" IsChecked="{Binding IsMatrix}"
                         AutomationProperties.AutomationId="challenge-matrix" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding Season, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Button Classes="btn icon" Height="32" Width="32" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}"
                    ToolTip.Tip="{loc:Tr Challenge_Prev}" AutomationProperties.AutomationId="challenge-prev">
              <c:StrokeIcon Width="16" Height="16" Data="{StaticResource Icon.ChevronLeft}" />
            </Button>
            <TextBlock Text="{Binding SeasonTitle}" FontSize="15" FontWeight="Bold" MinWidth="110" TextAlignment="Center" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="challenge-season" />
            <Button Classes="btn icon" Height="32" Width="32" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}"
                    ToolTip.Tip="{loc:Tr Challenge_Next}" AutomationProperties.AutomationId="challenge-next">
              <c:StrokeIcon Width="16" Height="16" Data="{StaticResource Icon.ChevronLeft}" RenderTransform="rotate(180deg)" />
            </Button>
          </StackPanel>

          <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Season, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Border Classes="ntag" Classes.upcoming="{Binding IsUpcomingSeason}" Classes.ended="{Binding !IsActiveSeason}"
                      IsVisible="{Binding !IsMatrix}">
                <TextBlock Text="{Binding SeasonStatus}" />
              </Border>
              <TextBlock Classes.mono="{Binding !IsMatrix}" Text="{Binding SeasonInfo}" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                         AutomationProperties.AutomationId="challenge-range" />
              <TextBlock Classes="caption" Text="{Binding SeasonStatus}" IsVisible="{Binding IsMatrix}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Panel VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="{loc:Tr Events_Refreshing}" IsVisible="{Binding IsRefreshing}" />
                <TextBlock Classes="caption" Text="{Binding UpdatedText}" IsVisible="{Binding !IsRefreshing}" AutomationProperties.AutomationId="challenge-updated" />
              </Panel>
              <Button Classes="link" Command="{Binding OpenSiteCommand}" ToolTip.Tip="{loc:Tr Challenge_Source}" AutomationProperties.AutomationId="challenge-site">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="{loc:Tr Challenge_OpenSite}" FontSize="12" VerticalAlignment="Center" />
                  <c:StrokeIcon Width="12" Height="12" Data="{StaticResource Icon.LinkAlt}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

    <ScrollViewer x:Name="ContentScroller" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" Margin="0,0,4,0">
      <!-- 加载中 / 失败 / 没有数据 -->
      <Border Classes="card" IsVisible="{Binding ShowLoading}" AutomationProperties.AutomationId="challenge-loading">
        <TextBlock Classes="caption" Text="{loc:Tr Challenge_Loading}" />
      </Border>
      <Border Classes="card" IsVisible="{Binding ShowFailed}" AutomationProperties.AutomationId="challenge-failed">
        <StackPanel Spacing="8">
          <TextBlock Classes="card-title" Text="{loc:Tr Challenge_Failed}" />
          <TextBlock Classes="caption" Text="{loc:Tr Events_FailedHint}" TextWrapping="Wrap" />
          <Button Classes="btn" HorizontalAlignment="Left" Content="{loc:Tr Events_Retry}" Command="{Binding RetryCommand}" />
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding ShowEmpty}">
        <TextBlock Classes="caption" Text="{loc:Tr Challenge_Empty}" />
      </Border>

      <!-- ── 逆境深塔：每个区域一张卡，4 层并排 ── -->
      <ItemsControl ItemsSource="{Binding TowerAreas}" IsVisible="{Binding HasTower}" AutomationProperties.AutomationId="challenge-tower-areas">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="events:TowerAreaItem">
            <Border Classes="card" Padding="20,16">
              <StackPanel Spacing="12">
                <TextBlock Classes="card-title" Text="{Binding Name}" />
                <Border Classes="mini" Padding="12,8" IsVisible="{Binding HasSharedBuffs}">
                  <ItemsControl ItemsSource="{Binding SharedBuffs}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="events:RichText">
                        <c:NoticeContent Classes="desc" Blocks="{Binding Blocks}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <ItemsControl ItemsSource="{Binding Floors}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" ColumnSpacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="events:TowerFloorItem">
                      <Border Classes="mini" Padding="12,10">
                        <StackPanel Spacing="10">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="tag"><TextBlock Text="{Binding CostText}" /></Border>
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Monsters}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="2" LineSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          </ItemsControl>
                          <ItemsControl ItemsSource="{Binding Buffs}" IsVisible="{Binding HasBuffs}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="events:RichText">
                                <c:NoticeContent Classes="desc" Blocks="{Binding Blocks}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ItemsControl ItemsSource="{Binding Targets}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="events:TowerTargetItem">
                                <Grid ColumnDefinitions="38,*">
                                  <TextBlock Text="{Binding Stars}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                                  <c:NoticeContent Grid.Column="1" Classes="desc" Blocks="{Binding Text.Blocks}" TextSize="12" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ── 冥歌海墟：信物，再按区域分组 ── -->
      <Border Classes="card" Padding="20,14" IsVisible="{Binding HasTokens}" AutomationProperties.AutomationId="challenge-tokens">
        <StackPanel Spacing="10">
          <TextBlock Classes="card-title" Text="{loc:Tr Challenge_Tokens}" />
          <ItemsControl ItemsSource="{Binding WastesTokens}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="18" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="events:TokenItem">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Border Classes="avatar" Classes.gold="{Binding IsGold}" Classes.purple="{Binding !IsGold}" Width="40" Height="40" CornerRadius="10">
                    <Image Source="{Binding Image}" Stretch="Uniform" Margin="3" />
                  </Border>
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding WastesGroups}" IsVisible="{Binding HasWastes}" AutomationProperties.AutomationId="challenge-wastes-groups">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="events:WastesGroupItem">
            <StackPanel Spacing="10">
              <!-- 分组名压在背景图上，垫一块胶囊底 -->
              <Border CornerRadius="999" Padding="12,4" HorizontalAlignment="Left" Background="{DynamicResource SurfaceBrush}"
                      IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" />
              </Border>
              <ItemsControl ItemsSource="{Binding Levels}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="14" RowSpacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="events:WastesLevelItem">
                    <Border Classes="card" Padding="18,14">
                      <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                          <TextBlock Classes="card-title" Text="{Binding Title}" VerticalAlignment="Center" />
                          <Border Grid.Column="1" Classes="ntag" IsVisible="{Binding IsEndless}"><TextBlock Text="{loc:Tr Challenge_Endless}" /></Border>
                          <TextBlock Grid.Column="2" Classes="caption mono" Text="{Binding GradesText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <c:NoticeContent Classes="desc" Blocks="{Binding Description.Blocks}" IsVisible="{Binding HasDescription}" />
                        <ItemsControl ItemsSource="{Binding Stages}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="events:WastesStageItem">
                              <Border Classes="mini" Padding="12,10">
                                <StackPanel Spacing="8">
                                  <TextBlock Classes="sub" Text="{Binding Title}" />
                                  <c:NoticeContent Classes="desc" Blocks="{Binding Description.Blocks}" IsVisible="{Binding HasDescription}" />
                                  <ItemsControl ItemsSource="{Binding Monsters}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="2" LineSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                  </ItemsControl>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ── 终焉矩阵：两个模式并排，最后是加成角色 ── -->
      <ItemsControl ItemsSource="{Binding MatrixModes}" IsVisible="{Binding HasMatrix}" AutomationProperties.AutomationId="challenge-matrix-modes">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="events:MatrixModeItem">
            <Border Classes="card" Padding="20,16">
              <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="card-title" Text="{Binding Name}" VerticalAlignment="Center" />
                    <Border Classes="tag" VerticalAlignment="Center"><TextBlock Text="{Binding TeamText}" /></Border>
                  </StackPanel>
                  <TextBlock Classes="caption mono" Text="{Binding GradesText}" />
                </StackPanel>

                <TextBlock Classes="sub" Text="{loc:Tr Challenge_Buffs}" />
                <ItemsControl ItemsSource="{Binding Buffs}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="events:MatrixBuffItem">
                      <Grid ColumnDefinitions="30,*" ColumnSpacing="10">
                        <!-- 增益图标是白色线稿，垫深色底 -->
                        <Border Classes="avatar" Width="30" Height="30" VerticalAlignment="Top" Background="{DynamicResource NavIslandBrush}">
                          <Image Source="{Binding Image}" Stretch="Uniform" Margin="3" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                          <c:NoticeContent Classes="desc" Blocks="{Binding Description.Blocks}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Rounds}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="events:MatrixRoundItem">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="sub" Text="{Binding Title}" IsVisible="{Binding HasTitle}" />
                        <ItemsControl ItemsSource="{Binding Enemies}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="events:MatrixEnemyItem">
                              <Border Classes="mini" Padding="12,10">
                                <Grid ColumnDefinitions="46,*" ColumnSpacing="12">
                                  <Panel Width="46" Height="46" VerticalAlignment="Top">
                                    <Border Classes="avatar">
                                      <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                    </Border>
                                    <Ellipse Classes="element" Fill="{Binding ElementBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                  </Panel>
                                  <StackPanel Grid.Column="1" Spacing="5">
                                    <WrapPanel ItemSpacing="6" LineSpacing="4">
                                      <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" />
                                      <TextBlock Text="{Binding ElementName}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ElementBrush}" VerticalAlignment="Center" />
                                      <ItemsControl ItemsSource="{Binding Tags}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate x:DataType="x:String">
                                            <Border Classes="tag"><TextBlock Text="{Binding}" /></Border>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                      <Border Classes="ntag" Height="20" IsVisible="{Binding HasScore}"><TextBlock Text="{Binding ScoreText}" /></Border>
                                    </WrapPanel>
                                    <c:NoticeContent Classes="desc" Blocks="{Binding Skills.Blocks}" IsVisible="{Binding HasSkills}" />
                                    <TextBlock Classes="caption" Text="{Binding FeatureText}" IsVisible="{Binding HasFeature}" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="card" Padding="20,16" IsVisible="{Binding HasRoles}" AutomationProperties.AutomationId="challenge-roles">
        <StackPanel Spacing="12">
          <TextBlock Classes="card-title" Text="{loc:Tr Challenge_Roles}" />
          <ItemsControl ItemsSource="{Binding MatrixRoles}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" ColumnSpacing="14" RowSpacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="events:MatrixRoleItem">
                <Grid ColumnDefinitions="44,*" ColumnSpacing="10">
                  <Border Classes="avatar" Classes.gold="{Binding IsGold}" Classes.purple="{Binding !IsGold}" Width="44" Height="44" VerticalAlignment="Top">
                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" />
                    <c:NoticeContent Classes="desc" Blocks="{Binding Description.Blocks}" TextSize="12" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Classes="caption" Text="{loc:Tr Challenge_Source}" TextWrapping="Wrap" Margin="4,0,4,8" HorizontalAlignment="Center" />
    </StackPanel>
  </ScrollViewer>
  </Grid>
</UserControl>
