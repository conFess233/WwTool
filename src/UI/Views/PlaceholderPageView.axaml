<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WwTool.UI.ViewModels"
             xmlns:loc="using:WwTool.UI.Localization"
             x:Class="WwTool.UI.Views.PlaceholderPageView"
             x:DataType="vm:PlaceholderPageViewModel">
  <!-- 尚未迁移页面的占位卡片。 -->
  <Border Margin="40,0,40,40" Padding="32" CornerRadius="20" VerticalAlignment="Top"
          Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock Text="{loc:Tr Page_Migrating}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" />
    </StackPanel>
  </Border>
</UserControl>
