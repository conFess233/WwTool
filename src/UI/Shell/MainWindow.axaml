<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:WwTool.Core.Localization"
        xmlns:loc="using:WwTool.UI.Localization"
        x:Class="WwTool.UI.Shell.MainWindow"
        Title="WwTool"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Icon="avares://WwTool/Assets/WwTool.ico">
  <!-- 阶段 0 原型：主题令牌预览与运行时切换。正式 Shell 完成后替换。 -->
  <ScrollViewer>
    <StackPanel Margin="40,26" Spacing="18">
      <TextBlock Text="主题原型" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />

      <!-- 语言原型：A = 编译绑定索引器（x:DataType + Source），B = 标记扩展 {loc:Tr} -->
      <WrapPanel x:Name="LanguageButtons" ItemSpacing="8" LineSpacing="8" />
      <StackPanel Orientation="Horizontal" Spacing="24" x:DataType="core:LocalizationService">
        <TextBlock x:Name="ProbeA" Text="{Binding [Nav_Home], Source={x:Static loc:TrExtension.Service}}" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock x:Name="ProbeA2" Text="{Binding [Nav_Statistics], Source={x:Static loc:TrExtension.Service}}" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock x:Name="ProbeB" Text="{loc:Tr Nav_Settings}" FontSize="16" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock x:Name="ProbeB2" Text="{loc:Tr Index_RefreshAccountList}" FontSize="16" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock x:Name="ProbeMissing" Text="{loc:Tr Missing_Key_Demo}" FontSize="16" Foreground="{DynamicResource DangerBrush}" />
      </StackPanel>
      <WrapPanel x:Name="PresetButtons" ItemSpacing="8" LineSpacing="8" />
      <WrapPanel x:Name="AccentButtons" ItemSpacing="8" LineSpacing="8" />

      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="{DynamicResource CornerRadiusCard}" Padding="22,18">
        <StackPanel Spacing="10">
          <TextBlock Text="卡片标题" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="正文文字 · Body text · 本文" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="次要说明文字（需 ≥ 4.5:1）" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="532" FontSize="42" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="999" Padding="16,8">
              <TextBlock Text="主要操作" Foreground="{DynamicResource TextOnAccentBrush}" FontWeight="SemiBold" />
            </Border>
            <Border Background="{DynamicResource AccentContainerBrush}" CornerRadius="999" Padding="16,8">
              <TextBlock Text="选中 Chip" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
            <Border Background="{DynamicResource DangerBrush}" CornerRadius="7" Padding="16,8">
              <TextBlock Text="危险" Foreground="White" />
            </Border>
            <Border Background="{DynamicResource NavIslandBrush}" CornerRadius="999" Padding="16,8">
              <TextBlock Text="悬浮岛" Foreground="{DynamicResource TextOnNavIslandBrush}" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
          <Grid ColumnDefinitions="*" Height="10">
            <Border Background="{DynamicResource SegmentTrackBrush}" />
            <Border Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Width="260" />
          </Grid>
        </StackPanel>
      </Border>

      <WrapPanel x:Name="Swatches" ItemSpacing="10" LineSpacing="10" />
    </StackPanel>
  </ScrollViewer>
</Window>
