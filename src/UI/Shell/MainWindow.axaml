<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:WwTool.UI.Shell"
        xmlns:vm="using:WwTool.UI.ViewModels"
        xmlns:fb="using:WwTool.UI.Feedback"
        xmlns:c="using:WwTool.UI.Controls"
        xmlns:pulls="using:WwTool.UI.Pages.Pulls"
        xmlns:domain="using:WwTool.Core.Models.Domain"
        xmlns:loc="using:WwTool.UI.Localization"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="WwTool.UI.Shell.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="WwTool"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        WindowDecorations="BorderOnly"
        Icon="avares://WwTool/Assets/WwTool.ico">
  <!-- Shell：56px 页头（左 Logo 与页名 · 中悬浮岛 · 右账号胶囊）+ 内容区。
       内容延伸进标题栏，托管标题栏高度设为 0；Windows/Linux 由应用绘制标题按钮，
       并标记 ElementRole（Win32 映射为 HTMINBUTTON/HTMAXBUTTON/HTCLOSE，保留 Win11 贴靠布局）。
       macOS 保留系统红绿灯，不显示这组按钮。 -->
  <Window.Styles>
    <!-- 账号数据页打开时账号胶囊显示选中态 -->
    <Style Selector="Button#AccountCapsule.on /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BoxShadow" Value="0 0 0 3 #33888888" />
    </Style>
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.caption /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
    </Style>
    <Style Selector="Button.caption.close:pointerover">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.caption Path">
      <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Stretch" Value="None" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*">
    <Grid x:Name="Header" Grid.Row="0" Height="56" Margin="40,26,40,18"
          ColumnDefinitions="*,Auto,*" Background="Transparent"
          PointerPressed="OnHeaderPointerPressed">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                  IsHitTestVisible="False">
        <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}">
          <Image Source="avares://WwTool/Assets/WwTool.ico" Width="44" Height="44" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding PageEyebrow}" FontSize="12" FontWeight="SemiBold" LetterSpacing="1"
                     Foreground="{DynamicResource AccentBrush}" />
          <TextBlock x:Name="PageTitle" Text="{Binding PageTitle}" FontSize="26" FontWeight="Bold" LineHeight="29"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>
      </StackPanel>

      <shell:FloatingNavIsland x:Name="Island" Grid.Column="1" VerticalAlignment="Center"
                               ItemsSource="{Binding NavItems}" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="0">
        <Button x:Name="AccountCapsule" Classes.on="{Binding IsAccountsPage}" AutomationProperties.AutomationId="account-capsule"
                AutomationProperties.Name="{loc:Tr Account_Switch}" ToolTip.Tip="{loc:Tr Account_Switch}"
                Height="44" Padding="6,0,14,0" CornerRadius="999" FocusAdorner="{x:Null}"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentContainerBrush}" ClipToBounds="True">
              <Panel>
                <TextBlock Text="{Binding Accounts.DisplayName, Converter={x:Static pulls:InitialConverter.Instance}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           IsVisible="{Binding #CapsuleAvatar.Source, Converter={x:Static ObjectConverters.IsNull}}" />
                <c:CatalogImage x:Name="CapsuleAvatar" Path="{Binding Accounts.Current.IconPath}" DecodeWidth="64"
                                Stretch="UniformToFill" IsVisible="{Binding Accounts.HasAccount}" />
              </Panel>
            </Border>
            <TextBlock Text="{Binding Accounts.DisplayName}" IsVisible="{Binding Accounts.HasAccount}" MaxWidth="160"
                       TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{loc:Tr Account_None}" IsVisible="{Binding !Accounts.HasAccount}"
                       FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{Binding Accounts.Current.Level, StringFormat='LV.{0}', FallbackValue=''}" IsVisible="{Binding Accounts.HasLevel}"
                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="8" MinWidth="260">
                <TextBlock Text="{loc:Tr Account_Switch}" FontWeight="SemiBold" Margin="4,0" />
                <ListBox ItemsSource="{Binding Accounts.Accounts}" SelectedItem="{Binding Accounts.Current}" MaxHeight="360"
                         AutomationProperties.AutomationId="account-list">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="domain:AccountSummary">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name, TargetNullValue=—}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Uid}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="{loc:Tr Accounts_Manage}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="OnManageAccountsClick" AutomationProperties.AutomationId="account-manage" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <!-- 系统标题按钮占位：宽度由代码按平台设置（Windows 右侧、macOS 左侧红绿灯不占右侧）。 -->
        <Border x:Name="CaptionButtonsSpacer" Width="0" />
      </StackPanel>
    </Grid>

    <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}" IsVisible="{Binding IsReady}" />
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                IsVisible="{Binding !IsReady}">
      <ProgressBar IsIndeterminate="True" Width="200" />
      <TextBlock Text="{loc:Tr Startup_Loading}" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
    </StackPanel>

    <!-- 悬浮按钮（遮罩只盖内容区）与 Toast 栈 -->
    <shell:FabMenu Grid.Row="1" DataContext="{Binding Fab}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsReady}" />
    <fb:ToastHost Grid.Row="1" DataContext="{Binding UiState}" Margin="0,0,32,0"
                  HorizontalAlignment="Right" VerticalAlignment="Top" />

    <!-- 对话框覆盖层盖住整个窗口（含页头），标题按钮仍在其上可用 -->
    <fb:DialogOverlay Grid.Row="0" Grid.RowSpan="2" DataContext="{Binding Dialogs}" />

    <StackPanel x:Name="CaptionButtons" Grid.Row="0" Orientation="Horizontal"
                HorizontalAlignment="Right" VerticalAlignment="Top">
      <Button x:Name="MinimizeButton" Classes="caption" Click="OnMinimizeClick"
              chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
              AutomationProperties.AutomationId="caption-minimize">
        <Path Data="M0,5.5 L10,5.5" />
      </Button>
      <Button x:Name="MaximizeButton" Classes="caption" Click="OnMaximizeClick"
              chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
              AutomationProperties.AutomationId="caption-maximize">
        <Path x:Name="MaximizeGlyph" Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" />
      </Button>
      <Button Classes="caption close" Click="OnCloseClick"
              chrome:WindowDecorationProperties.ElementRole="CloseButton"
              AutomationProperties.AutomationId="caption-close">
        <Path Data="M0,0 L10,10 M10,0 L0,10" />
      </Button>
    </StackPanel>
  </Grid>
</Window>
