<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:WwTool.UI.Shell"
             x:Class="WwTool.UI.Shell.FloatingNavIsland">
  <!--
    悬浮岛（开发文档「悬浮岛导航」）：Ink 底胶囊，内边距 6、项间距 4，悬浮岛阴影；深色主题加 1 宽描边。
    未选中项 44 × 44 只显示 22 图标（不透明度 75%）；选中项展开为「图标 + 页面名」，左右内边距 14 / 18。
    选中底色是独立的金色胶囊，切换时带回弹滑到新位置（320ms）。
  -->
  <UserControl.Styles>
    <Style Selector="RadioButton.nav">
      <Setter Property="Height" Value="44" />
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnNavIslandBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Hover" CornerRadius="999" Background="Transparent" Padding="{TemplateBinding Padding}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Border#PART_Hover">
      <Setter Property="Background" Value="#1FFFFFFF" />
    </Style>
    <Style Selector="RadioButton.nav:checked">
      <Setter Property="Padding" Value="14,0,18,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#PART_Hover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="RadioButton.nav:focus-visible /template/ Border#PART_Hover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="RadioButton.nav Rectangle.icon">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="RadioButton.nav:checked Rectangle.icon">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- 悬停提示气泡：Ink 底、圆角 8、内边距 7 / 12，顶部小三角；下移 6 淡入 180ms -->
    <Style Selector="ToolTip.nav-tip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToolTip.nav-tip:open">
      <Style.Animations>
        <Animation Duration="0:0:0.18" Easing="0.2,0.8,0.2,1" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-6" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Border x:Name="Island" Background="{DynamicResource NavIslandBrush}" BorderBrush="{DynamicResource NavIslandBorderBrush}"
          BorderThickness="1" CornerRadius="999" Padding="5" BoxShadow="{DynamicResource ShadowIsland}">
    <Panel>
      <!-- 选中胶囊：位置与宽度由代码跟随选中项设置，过渡带回弹 -->
      <Border x:Name="Pill" Background="{DynamicResource AccentBrush}" CornerRadius="999" Height="44" Width="0"
              HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
              RenderTransform="translateX(0px)" />
      <ItemsControl x:Name="ItemsHost">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="shell:NavItem">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Width="1" Height="22" Margin="6,0" Background="#33FFFFFF" IsVisible="{Binding StartsGroup}" />
              <RadioButton Classes="nav" GroupName="ShellNav" IsChecked="{Binding IsSelected}"
                           AutomationProperties.Name="{Binding Title}"
                           AutomationProperties.AutomationId="{Binding AutomationId}"
                           ToolTip.ShowDelay="300" ToolTip.BetweenShowDelay="600" ToolTip.Placement="Bottom"
                           ToolTip.VerticalOffset="14" ToolTip.ServiceEnabled="{Binding ShowTip}">
                <ToolTip.Tip>
                  <ToolTip Classes="nav-tip" RenderTransform="translateY(0px)">
                    <StackPanel>
                      <Path Data="M0,6 L6,0 L12,6 Z" Fill="{DynamicResource NavIslandBrush}" HorizontalAlignment="Center" />
                      <Border Background="{DynamicResource NavIslandBrush}" CornerRadius="8" Padding="12,7"
                              BoxShadow="0 10 20 -10 #99281C0A">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                          <TextBlock Text="{Binding Shortcut}" FontSize="11" Foreground="#C9B892" IsVisible="{Binding HasShortcut}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ToolTip>
                </ToolTip.Tip>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <!-- 图标作为遮罩，用前景色填充：任何主题下都是单色且对比清晰。 -->
                  <Rectangle Classes="icon" Width="22" Height="22" Fill="{Binding $parent[RadioButton].Foreground}">
                    <Rectangle.OpacityMask>
                      <ImageBrush Source="{Binding Icon, Converter={x:Static shell:AssetImageConverter.Instance}}" Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                  </Rectangle>
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                             TextWrapping="NoWrap" Foreground="{Binding $parent[RadioButton].Foreground}"
                             IsVisible="{Binding IsSelected}" />
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Panel>
  </Border>
</UserControl>
