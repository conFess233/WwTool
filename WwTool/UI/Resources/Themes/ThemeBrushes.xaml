<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" Opacity="{DynamicResource MaterialOpacity}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" Opacity="{DynamicResource MaterialOpacity}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{DynamicResource SurfaceElevatedColor}" Opacity="{DynamicResource ElevatedMaterialOpacity}" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{DynamicResource SurfaceMutedColor}" Opacity="{DynamicResource MaterialOpacity}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHoverColor}" Opacity="{DynamicResource ElevatedMaterialOpacity}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource BorderStrongColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource DividerColor}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{DynamicResource DisabledColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{DynamicResource TextOnAccentColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentContainerBrush" Color="{DynamicResource AccentContainerColor}" />
    <SolidColorBrush x:Key="AccentContainerHoverBrush" Color="{DynamicResource AccentContainerHoverColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{DynamicResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerContainerBrush" Color="{DynamicResource DangerContainerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="WarningContainerBrush" Color="{DynamicResource WarningContainerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessContainerBrush" Color="{DynamicResource SuccessContainerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}" />
    <SolidColorBrush x:Key="InfoContainerBrush" Color="{DynamicResource InfoContainerColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{DynamicResource FocusRingColor}" />
    <SolidColorBrush x:Key="ChartPrimaryBrush" Color="{DynamicResource ChartPrimaryColor}" />
    <SolidColorBrush x:Key="ChartSecondaryBrush" Color="{DynamicResource ChartSecondaryColor}" />
    <SolidColorBrush x:Key="ChartTertiaryBrush" Color="{DynamicResource ChartTertiaryColor}" />
    <SolidColorBrush x:Key="ChartFourStarBrush" Color="{DynamicResource ChartFourStarColor}" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="{DynamicResource ChartGridColor}" />

    <RadialGradientBrush x:Key="BackgroundAtmosphereBrush" Center="0.82,0.08" GradientOrigin="0.82,0.08" RadiusX="0.75" RadiusY="0.75" Opacity="{DynamicResource AtmosphereOpacity}">
        <GradientStop Offset="0" Color="{DynamicResource AtmosphereColor}" /><GradientStop Offset="1" Color="#00000000" />
    </RadialGradientBrush>
    <DrawingBrush x:Key="BackgroundTextureBrush" Viewport="0,0,32,32" ViewportUnits="Absolute" TileMode="Tile" Opacity="{DynamicResource BackgroundTextureOpacity}">
        <DrawingBrush.Drawing><DrawingGroup><GeometryDrawing><GeometryDrawing.Brush><SolidColorBrush Color="{DynamicResource BackgroundTextureColor}" /></GeometryDrawing.Brush><GeometryDrawing.Geometry><GeometryGroup><EllipseGeometry Center="3,5" RadiusX="0.45" RadiusY="0.45" /><EllipseGeometry Center="17,9" RadiusX="0.35" RadiusY="0.35" /><EllipseGeometry Center="27,21" RadiusX="0.5" RadiusY="0.5" /><EllipseGeometry Center="10,27" RadiusX="0.3" RadiusY="0.3" /></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="StandardFocusVisualStyle" TargetType="{x:Type Control}"><Setter Property="Template"><Setter.Value><ControlTemplate><Border Margin="-3" BorderBrush="{DynamicResource FocusRingBrush}" BorderThickness="2" CornerRadius="{DynamicResource CornerRadiusSmall}" /></ControlTemplate></Setter.Value></Setter></Style>
    <DropShadowEffect x:Key="ShadowSm" BlurRadius="5" Direction="270" Opacity="1" RenderingBias="Performance" ShadowDepth="2" Color="{DynamicResource ShadowLightColor}" />
    <DropShadowEffect x:Key="NavBarShadow" BlurRadius="5" Direction="270" Opacity="1" RenderingBias="Performance" ShadowDepth="2" Color="{DynamicResource ShadowDarkColor}" />
    <DropShadowEffect x:Key="ShadowMd" BlurRadius="12" Direction="270" Opacity="1" RenderingBias="Performance" ShadowDepth="4" Color="{DynamicResource ShadowDarkColor}" />
    <DropShadowEffect x:Key="ShadowLg" BlurRadius="40" Direction="270" Opacity="1" RenderingBias="Performance" ShadowDepth="12" Color="{DynamicResource ShadowDarkColor}" />
    <DropShadowEffect x:Key="FocusShadow" BlurRadius="12" Opacity="0.1" RenderingBias="Performance" ShadowDepth="0" Color="{DynamicResource FocusShadowColor}" />

    <!-- Legacy aliases remain for rollback and unconverted third-party templates. -->
    <SolidColorBrush x:Key="PageBgBrush" Color="{DynamicResource BackgroundColor}" Opacity="{DynamicResource MaterialOpacity}" /><SolidColorBrush x:Key="CardBgBrush" Color="{DynamicResource SurfaceColor}" Opacity="{DynamicResource MaterialOpacity}" /><SolidColorBrush x:Key="SolidBgBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource AccentColor}" /><SolidColorBrush x:Key="PrimaryHoverBrush" Color="{DynamicResource AccentHoverColor}" /><SolidColorBrush x:Key="TextMainBrush" Color="{DynamicResource TextPrimaryColor}" /><SolidColorBrush x:Key="TextSubBrush" Color="{DynamicResource TextSecondaryColor}" /><SolidColorBrush x:Key="TextPlaceholderBrush" Color="{DynamicResource TextMutedColor}" /><SolidColorBrush x:Key="ButtonTextBrush" Color="{DynamicResource TextOnAccentColor}" />
    <SolidColorBrush x:Key="HoverBgBrush" Color="{DynamicResource SurfaceHoverColor}" /><SolidColorBrush x:Key="ActiveBgBrush" Color="{DynamicResource AccentContainerColor}" /><SolidColorBrush x:Key="ActiveTextBrush" Color="{DynamicResource AccentColor}" /><SolidColorBrush x:Key="DisabledBgBrush" Color="{DynamicResource DisabledColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{DynamicResource BorderColor}" /><SolidColorBrush x:Key="TextBoxStrokeBrush" Color="{DynamicResource BorderStrongColor}" /><SolidColorBrush x:Key="ButtonBgBrush" Color="{DynamicResource AccentColor}" /><SolidColorBrush x:Key="ButtonStrokeBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="CancelButtonBgBrush" Color="{DynamicResource DangerContainerColor}" /><SolidColorBrush x:Key="CancelButtonHoverBrush" Color="{DynamicResource DangerHoverColor}" /><SolidColorBrush x:Key="CancelButtonStrokeBrush" Color="{DynamicResource DangerColor}" /><SolidColorBrush x:Key="OkButtonBgBrush" Color="{DynamicResource SuccessContainerColor}" /><SolidColorBrush x:Key="OkButtonHoverBrush" Color="{DynamicResource SuccessColor}" /><SolidColorBrush x:Key="OkButtonStrokeBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="CheckedBrush" Color="{DynamicResource AccentColor}" /><SolidColorBrush x:Key="SelectedBgBrush" Color="{DynamicResource AccentContainerColor}" /><SolidColorBrush x:Key="UnselectedBgBrush" Color="#00000000" /><SolidColorBrush x:Key="ToggleOnBgBrush" Color="{DynamicResource AccentColor}" /><SolidColorBrush x:Key="ToggleOffBgBrush" Color="{DynamicResource BorderStrongColor}" /><SolidColorBrush x:Key="WarningTextBrush" Color="{DynamicResource WarningColor}" /><SolidColorBrush x:Key="SuccessTextBrush" Color="{DynamicResource SuccessColor}" />
    <LinearGradientBrush x:Key="UnderLineBrush" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Offset="0" Color="#00000000" /><GradientStop Offset="0.5" Color="{DynamicResource DividerColor}" /><GradientStop Offset="1" Color="#00000000" /></LinearGradientBrush>
</ResourceDictionary>
