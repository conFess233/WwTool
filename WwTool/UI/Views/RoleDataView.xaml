<UserControl
    x:Class="WwTool.UI.Views.RoleDataView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:WwTool.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:WwTool.Common.Utils"
    d:DesignHeight="760"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <cv:ImageConverter x:Key="ImageConverter" />

        <Style x:Key="GuideCardBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="156" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Star}" Value="5">
                    <Setter Property="BorderBrush" Value="{DynamicResource RarityFiveStarBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Star}" Value="4">
                    <Setter Property="BorderBrush" Value="{DynamicResource RarityFourStarBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Star}" Value="3">
                    <Setter Property="BorderBrush" Value="{DynamicResource RarityThreeStarBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GuideStarBadgeStyle" TargetType="Border">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Star}" Value="5">
                    <Setter Property="Background" Value="{DynamicResource RarityFiveStarBadgeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Star}" Value="4">
                    <Setter Property="Background" Value="{DynamicResource RarityFourStarBadgeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GuideResonanceBadgeStyle" TargetType="Border">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource ResonanceZeroBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Sequence}" Value="1"><Setter Property="Background" Value="{DynamicResource ResonanceOneBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Sequence}" Value="2"><Setter Property="Background" Value="{DynamicResource ResonanceTwoBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Sequence}" Value="3"><Setter Property="Background" Value="{DynamicResource ResonanceThreeBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Sequence}" Value="4"><Setter Property="Background" Value="{DynamicResource ResonanceFourBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Sequence}" Value="5"><Setter Property="Background" Value="{DynamicResource ResonanceFiveBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Sequence}" Value="6"><Setter Property="Background" Value="{DynamicResource ResonanceSixBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GuideSortComboBoxItemStyle" BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="ComboBoxItem">
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="ToolTip" Value="{Binding DisabledHint}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <DataTemplate x:Key="RoleCardTemplate">
            <Border Style="{StaticResource GuideCardBorderStyle}" ToolTip="{Binding ToolTipText}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ClipToBounds="True">
                        <Image Source="{Binding IconPath, Converter={StaticResource ImageConverter}, ConverterParameter=120, IsAsync=True}" Stretch="UniformToFill" />
                        <Border Style="{StaticResource GuideStarBadgeStyle}">
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="White" Text="{Binding Star, StringFormat={}{0}★}" />
                        </Border>
                        <Border Style="{StaticResource GuideResonanceBadgeStyle}">
                            <TextBlock FontWeight="SemiBold" Foreground="White" Text="{Binding SequenceLabel}" />
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Background="#E6151517" CornerRadius="0,0,6,6">
                        <Grid>
                            <TextBlock
                                Margin="6,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WeaponCardTemplate">
            <Border Style="{StaticResource GuideCardBorderStyle}" ToolTip="{Binding ToolTipText}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="48" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ClipToBounds="True">
                        <Image Source="{Binding IconPath, Converter={StaticResource ImageConverter}, ConverterParameter=120, IsAsync=True}" Stretch="Uniform" />
                        <Border Style="{StaticResource GuideStarBadgeStyle}">
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="White" Text="{Binding Star, StringFormat={}{0}★}" />
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Background="#E6151517" CornerRadius="0,0,6,6">
                        <StackPanel Margin="6,3">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock FontSize="11" Foreground="#CFCFCF" Text="{Binding Path=[Guide_Owner], Source={x:Static utils:LanguageManager.Instance}}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="#CFCFCF"
                                    Text="{Binding OwnerName}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="{Binding Path=[Nav_RoleData], Source={x:Static utils:LanguageManager.Instance}}" />
                    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Path=[Guide_PageDescription], Source={x:Static utils:LanguageManager.Instance}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <ComboBox
                        Width="220"
                        Margin="0,0,10,0"
                        ItemsSource="{Binding Users}"
                        SelectedItem="{Binding SelectedUser}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Uid}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Command="{Binding SyncCommand}" Content="{Binding Path=[Guide_Sync], Source={x:Static utils:LanguageManager.Instance}}" />
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="1"
                Margin="0,0,0,20"
                Padding="24"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadiusCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Path=[Guide_RoleCount], Source={x:Static utils:LanguageManager.Instance}}" />
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="28"
                            FontWeight="Bold"
                            Text="{Binding RoleCount}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Path=[Guide_WeaponCount], Source={x:Static utils:LanguageManager.Instance}}" />
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="28"
                            FontWeight="Bold"
                            Text="{Binding WeaponCount}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Path=[Guide_LastSynced], Source={x:Static utils:LanguageManager.Instance}}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{Binding LastSyncedText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Padding="18"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadiusCard}">
                <TabControl>
                    <TabItem Header="{Binding Path=[Guide_RolesTab], Source={x:Static utils:LanguageManager.Instance}}">
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel Margin="0,0,0,12" HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding Path=[Guide_Sort], Source={x:Static utils:LanguageManager.Instance}}" />
                                <ComboBox
                                    Width="150"
                                    ItemContainerStyle="{StaticResource GuideSortComboBoxItemStyle}"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding RoleSortOptions}"
                                    SelectedItem="{Binding SelectedRoleSort}" />
                            </StackPanel>
                            <TextBlock
                                Margin="8,34"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="{Binding Path=[Guide_NoRoles], Source={x:Static utils:LanguageManager.Instance}}"
                                Visibility="{Binding HasRoles, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}" />
                            <ItemsControl ItemTemplate="{StaticResource RoleCardTemplate}" ItemsSource="{Binding Roles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="{Binding Path=[Guide_WeaponsTab], Source={x:Static utils:LanguageManager.Instance}}">
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel Margin="0,0,0,12" HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding Path=[Guide_Sort], Source={x:Static utils:LanguageManager.Instance}}" />
                                <ComboBox
                                    Width="150"
                                    ItemContainerStyle="{StaticResource GuideSortComboBoxItemStyle}"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding WeaponSortOptions}"
                                    SelectedItem="{Binding SelectedWeaponSort}" />
                            </StackPanel>
                            <TextBlock
                                Margin="8,34"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="{Binding Path=[Guide_NoWeapons], Source={x:Static utils:LanguageManager.Instance}}"
                                Visibility="{Binding HasWeapons, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}" />
                            <ItemsControl ItemTemplate="{StaticResource WeaponCardTemplate}" ItemsSource="{Binding Weapons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
