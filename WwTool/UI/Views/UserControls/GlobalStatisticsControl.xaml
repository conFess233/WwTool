<UserControl
    x:Class="WwTool.UI.Views.UserControls.GlobalStatisticsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="clr-namespace:WwTool.UI.Components"
    xmlns:utils="clr-namespace:WwTool.Common.Utils"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800">
    <catalog:ResponsiveUniformGrid Margin="16" MaximumColumns="5" MinimumItemWidth="200" VerticalAlignment="Top">
        <Border Margin="0,0,8,12" Padding="{StaticResource CardPadding}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="{Binding Path=[Stat_GameId], Source={x:Static utils:LanguageManager.Instance}}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource HeaderTextStyle}" Text="{Binding UserId, TargetNullValue=—}" />
            </StackPanel>
        </Border>
        <Border Margin="0,0,8,12" Padding="{StaticResource CardPadding}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="{Binding Path=[Stat_TotalTides], Source={x:Static utils:LanguageManager.Instance}}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource HeaderTextStyle}" Text="{Binding TotalTides, TargetNullValue=—, StringFormat=N0}" />
            </StackPanel>
        </Border>
        <Border Margin="0,0,8,12" Padding="{StaticResource CardPadding}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="{Binding Path=[Stat_TotalAstrites], Source={x:Static utils:LanguageManager.Instance}}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource HeaderTextStyle}" Text="{Binding TotalAstrites, TargetNullValue=—, StringFormat=N0}" />
            </StackPanel>
        </Border>
        <Border Margin="0,0,8,12" Padding="{StaticResource CardPadding}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="{Binding Path=[Stat_MissCount], Source={x:Static utils:LanguageManager.Instance}}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource HeaderTextStyle}" Text="{Binding MissCount, TargetNullValue=—, StringFormat=N0}" />
            </StackPanel>
        </Border>
        <Border Margin="0,0,8,12" Padding="{StaticResource CardPadding}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="{Binding Path=[Stat_AvgLimitChara], Source={x:Static utils:LanguageManager.Instance}}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource HeaderTextStyle}" Text="{Binding AvgLimitCharaTide, TargetNullValue=—, StringFormat=F2}" />
            </StackPanel>
        </Border>
        <Border Margin="0,0,8,12" Padding="{StaticResource CardPadding}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="{Binding Path=[Stat_SuccessCount], Source={x:Static utils:LanguageManager.Instance}}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource HeaderTextStyle}" Text="{Binding SuccessCount, TargetNullValue=—, StringFormat=N0}" />
            </StackPanel>
        </Border>
        <Border Margin="0,0,8,12" Padding="{StaticResource CardPadding}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="{Binding Path=[Stat_SuccessRate], Source={x:Static utils:LanguageManager.Instance}}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource HeaderTextStyle}" Text="{Binding SuccessRate, TargetNullValue=—, StringFormat={}{0:F2} %}" />
            </StackPanel>
        </Border>
        <Border Margin="0,0,8,12" Padding="{StaticResource CardPadding}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="{Binding Path=[Stat_LimitGoldCount], Source={x:Static utils:LanguageManager.Instance}}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource HeaderTextStyle}" Text="{Binding LimitedGoldCount, TargetNullValue=—, StringFormat=N0}" />
            </StackPanel>
        </Border>
        <Border Margin="0,0,8,12" Padding="{StaticResource CardPadding}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="{Binding Path=[Stat_TotalGoldCount], Source={x:Static utils:LanguageManager.Instance}}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource HeaderTextStyle}" Text="{Binding TotalHitGold, TargetNullValue=—, StringFormat=N0}" />
            </StackPanel>
        </Border>
        <Border Margin="0,0,8,12" Padding="{StaticResource CardPadding}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="{Binding Path=[Stat_AvgChara], Source={x:Static utils:LanguageManager.Instance}}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource HeaderTextStyle}" Text="{Binding AvgCharaTide, TargetNullValue=—, StringFormat=F2}" />
            </StackPanel>
        </Border>
    </catalog:ResponsiveUniformGrid>
</UserControl>
