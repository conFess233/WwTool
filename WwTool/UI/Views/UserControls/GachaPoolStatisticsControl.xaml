<UserControl
    x:Class="WwTool.UI.Views.UserControls.GachaPoolStatisticsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="clr-namespace:WwTool.UI.Components"
    xmlns:b="clr-namespace:WwTool.Common.Behaviors"
    xmlns:cv="clr-namespace:WwTool.Common.Converters"
    xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
    xmlns:utils="clr-namespace:WwTool.Common.Utils"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <cv:CurrentPityConverter x:Key="CurrentPityConverter" />
        <cv:ItemIdToNameConverter x:Key="ItemIdToNameConverter" Catalog="{StaticResource GameCatalog}" />
    </UserControl.Resources>
    <Grid>
        <ScrollViewer x:Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,10,0,10">

                <Border
                    Margin="10,0,10,10"
                    Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusCard}">
                    <catalog:ResponsiveUniformGrid MaximumColumns="4" MinimumItemWidth="200">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextStyle}" Text="{Binding Path=[Stat_UsedTides], Source={x:Static utils:LanguageManager.Instance}}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource FontSizeXl}"
                                Style="{StaticResource HeaderTextStyle}"
                                Text="{Binding Calculate.Tides}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextStyle}" Text="{Binding Path=[Stat_GoldCount], Source={x:Static utils:LanguageManager.Instance}}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource FontSizeXl}"
                                Style="{StaticResource HeaderTextStyle}"
                                Text="{Binding Calculate.HitGoldCount}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextStyle}" Text="{Binding Path=[Stat_PoolCurrentPity], Source={x:Static utils:LanguageManager.Instance}}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource FontSizeXl}"
                                Style="{StaticResource HeaderTextStyle}"
                                >
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrentPityConverter}">
                                        <Binding Path="HitGoldDatas" />
                                        <Binding Path="HitGoldDatas.Count" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextStyle}" Text="{Binding Path=[Stat_AvgGold], Source={x:Static utils:LanguageManager.Instance}}" />
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeXl}"
                                    Style="{StaticResource HeaderTextStyle}"
                                    Text="{Binding Calculate.AvgGoldTide, TargetNullValue=—, StringFormat={}{0:F2}}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeXl}"
                                    Style="{StaticResource HeaderTextStyle}"
                                    Text="{Binding Path=[Unit_Pull], Source={x:Static utils:LanguageManager.Instance}}" />
                            </StackPanel>
                        </StackPanel>
                    </catalog:ResponsiveUniformGrid>
                </Border>

                <ListBox MaxHeight="480" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ItemsSource="{Binding HitGoldDatas}"
                    ScrollViewer.CanContentScroll="True"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="5,3"
                                Padding="4"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource CornerRadiusCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="10,0,0,0" HorizontalAlignment="Center">
                                        <catalog:CatalogImage
                                            Width="48"
                                            Height="48"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Loader="{DynamicResource CatalogImageLoader}" Path="{Binding GachaData.IconPath}" />
                                        <TextBlock
                                            Width="80"
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="{StaticResource FontSizeXs}"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding GachaData.Time}"
                                            TextAlignment="Center"
                                            TextWrapping="WrapWithOverflow" />
                                    </StackPanel>

                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel MinWidth="100" MaxWidth="200" Orientation="Horizontal">
                                            <TextBlock
                                                Grid.Column="0"
                                                FontSize="15"
                                                Foreground="{DynamicResource WarningBrush}"
                                                Style="{StaticResource TitleTextStyle}"
                                                TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource ItemIdToNameConverter}">
                                                        <Binding Path="GachaData.ResourceId" />
                                                        <Binding Path="CurrentLanguage" Source="{x:Static utils:LanguageManager.Instance}" />
                                                        <Binding Path="GachaData.Name" />
                                                        <Binding Path="Revision" Source="{StaticResource GameCatalog}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>


                                        <StackPanel Grid.Column="1" Margin="10,0,5,0" VerticalAlignment="Center">
                                            <ProgressBar
                                                Height="20"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource SuccessBrush}"
                                                Maximum="80"
                                                Style="{StaticResource GachaBar}"
                                                Value="{Binding Pity}" />
                                            <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding FourStarHistories}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,8,0" Orientation="Horizontal">
                                                            <catalog:CatalogImage Width="24" Height="24" Loader="{DynamicResource CatalogImageLoader}" Path="{Binding IconPath}" />
                                                            <TextBlock
                                                                Margin="2,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="{StaticResource FontSizeXs}"
                                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                                Text="{Binding Count, StringFormat='x{0}'}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>

        <Button
            x:Name="BtnBackToTop"
            Width="40"
            Height="40"
            Margin="0,0,20,20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{DynamicResource SurfaceBrush}"
            Opacity="0.8"
            Style="{StaticResource SystemButtonStyle}"
            Visibility="Collapsed">
            <i:Interaction.Behaviors>
                <b:ScrollToTopBehavior TargetScrollViewer="{Binding Source={x:Reference PART_ScrollViewer}}" />
            </i:Interaction.Behaviors>
            <Path
                Width="16"
                Height="16"
                Data="M 10,20 L 10,6 M 4,12 L 10,6 L 16,12"
                Stretch="Uniform"
                Stroke="{DynamicResource TextPrimaryBrush}"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="2" />
            <Button.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource MotionNormal}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.8" Duration="{StaticResource MotionNormal}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Button.Triggers>
        </Button>
    </Grid>
</UserControl>
