<UserControl
    x:Class="WwTool.UI.Components.NotificationItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:WwTool.Common.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:WwTool.Common.Utils"
    x:Name="Root"
    Width="320"
    Margin="0,0,0,10"
    GotKeyboardFocus="OnGotKeyboardFocus"
    LostKeyboardFocus="OnLostKeyboardFocus"
    MouseEnter="OnMouseEnter"
    MouseLeave="OnMouseLeave"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="StatusBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InfoBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:NotificationType.Success}">
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:NotificationType.Warning}">
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:NotificationType.Error}">
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:NotificationType.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:NotificationType.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:NotificationType.Error}">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToastActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusVisualStyle}" />
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CornerRadiusSmall}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:NotificationType.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:NotificationType.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:NotificationType.Error}">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToastCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBackground" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusSmall}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border
        x:Name="ToastCard"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        ClipToBounds="True"
        CornerRadius="{DynamicResource CornerRadiusCard}">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="16"
                Direction="270"
                Opacity="0.14"
                ShadowDepth="3"
                Color="{DynamicResource ShadowDarkColor}" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.RowSpan="2" Style="{StaticResource StatusBorderStyle}" />

            <Grid Grid.Column="1" Margin="12,10,10,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="24"
                    Height="24"
                    VerticalAlignment="Top"
                    CornerRadius="12"
                    Opacity="0.18"
                    Style="{StaticResource StatusBorderStyle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Style="{StaticResource StatusTextStyle}"
                    Text="{Binding IconGlyph}" />

                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            MaxWidth="205"
                            FontSize="13"
                            Style="{StaticResource TitleTextStyle}"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Margin="6,0,0,0"
                            Padding="5,0"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            CornerRadius="8"
                            Visibility="{Binding HasRepeats, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding RepeatText}" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        MaxHeight="48"
                        Margin="0,3,0,0"
                        LineHeight="16"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="{Binding Message}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />

                    <Button
                        Margin="0,8,0,0"
                        Padding="8,3"
                        HorizontalAlignment="Left"
                        Command="{Binding ActionCommand}"
                        Content="{Binding ActionText}"
                        Style="{StaticResource ToastActionButtonStyle}"
                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Top"
                    Command="{Binding CloseCommand}"
                    Content="×"
                    Style="{StaticResource ToastCloseButtonStyle}"
                    ToolTip="{Binding Path=[Action_Close], Source={x:Static utils:LanguageManager.Instance}}" />
            </Grid>

            <Grid Grid.Column="1" Height="2" VerticalAlignment="Bottom" ClipToBounds="True">
                <Border
                    HorizontalAlignment="Stretch"
                    Opacity="0.3"
                    RenderTransformOrigin="0,0.5"
                    Style="{StaticResource StatusBorderStyle}"
                    Visibility="{Binding IsProgress, Converter={StaticResource BoolToVisibility}}">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Progress}" />
                    </Border.RenderTransform>
                </Border>
                <Border
                    HorizontalAlignment="Stretch"
                    Opacity="0.28"
                    RenderTransformOrigin="0,0.5"
                    >
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding RemainingRatio}" />
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style BasedOn="{StaticResource StatusBorderStyle}" TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProgress}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
